{
  "name": "@ncai/design-system",
  "version": "0.4.1",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./design-system.md": "./dist/design-system.md"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GronkOut/ncai-design-system.git",
    "directory": "packages/design-system"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --out-dir dist --clean && node scripts/copy-assets.mjs",
    "lint": "tsc --noEmit",
    "test": "vitest run src",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm build && node scripts/validate-design-system.mjs",
    "prepublishOnly": "node ../../scripts/ensure-github-actions-publish.mjs"
  },
  "devDependencies": {
    "tsx": "catalog:"
  }
}
