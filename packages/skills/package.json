{
  "name": "@ncai/design-system-skills",
  "version": "0.2.1",
  "license": "MIT",
  "type": "module",
  "files": [
    "ncai-design-system",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GronkOut/ncai-design-system.git",
    "directory": "packages/skills"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').mkdirSync('dist',{recursive:true});require('node:fs').writeFileSync('dist/README.txt','Skill package assets are shipped from ncai-design-system/.\\n')\"",
    "lint": "node -e \"console.log('skills package: no lint required')\"",
    "test": "node -e \"console.log('skills package: no tests required')\"",
    "typecheck": "node -e \"console.log('skills package: no typecheck required')\"",
    "validate": "node -e \"const fs=require('node:fs');const p='ncai-design-system/SKILL.md';const s=fs.readFileSync(p,'utf8');if(!s.includes('name: ncai-design-system'))process.exit(1);console.log('skill metadata ok')\""
  }
}
