{
  "name": "@ncai/design-system-mcp",
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ncai-design-system-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GronkOut/ncai-design-system.git",
    "directory": "packages/mcp"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --out-dir dist --clean --external @modelcontextprotocol/sdk --external zod",
    "lint": "tsc --noEmit",
    "start": "tsx src/index.ts",
    "test": "vitest run src",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "catalog:",
    "@ncai/design-system": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "tsx": "catalog:"
  }
}
