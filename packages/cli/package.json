{
  "name": "@ncai/design-system-cli",
  "version": "0.9.0",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ncai-design-system": "./dist/index.js",
    "ncai-ds": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GronkOut/ncai-design-system.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --out-dir dist --clean",
    "lint": "tsc --noEmit",
    "test": "node -e \"console.log('cli package: no tests required')\"",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm build",
    "prepublishOnly": "node ../../scripts/ensure-github-actions-publish.mjs"
  },
  "dependencies": {
    "@ncai/design-system": "workspace:*",
    "@ncai/design-system-icons": "workspace:*",
    "@ncai/design-system-skills": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:"
  }
}
