{
  "name": "@ncai/design-system-icons",
  "version": "0.7.0",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./icons/*": "./icons/*",
    "./README.md": "./icons/README.md"
  },
  "files": [
    "dist",
    "icons",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GronkOut/ncai-design-system.git",
    "directory": "packages/icons"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsx scripts/generate-icon-index.ts && tsup src/index.ts --format esm --dts --out-dir dist --clean",
    "lint": "tsc --noEmit",
    "test": "vitest run src",
    "typecheck": "tsc --noEmit",
    "validate": "tsx scripts/generate-icon-index.ts --check && node scripts/validate-icons.mjs",
    "prepublishOnly": "node ../../scripts/ensure-github-actions-publish.mjs"
  },
  "devDependencies": {
    "tsx": "catalog:",
    "vitest": "catalog:"
  }
}
