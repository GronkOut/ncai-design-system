{
  "name": "ncai-design-system",
  "version": "0.2.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "release": "pnpm typecheck && pnpm validate && pnpm test && pnpm build && pnpm smoke:pack && node scripts/publish-missing.mjs",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "validate": "turbo validate",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "mcp": "pnpm --filter @ncai/design-system-mcp start"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
